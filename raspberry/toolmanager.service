[Unit]
Description=Gestion des outils (serveur web)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@DIR@
Environment=TM_PORT=8080
# Clé pour que les machines / automates envoient leurs coups (à personnaliser)
Environment=TM_API_KEY=changez-moi
ExecStart=@DIR@/.venv/bin/python @DIR@/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
